{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["src/webview/**/*", "shared/**/*"],
  "exclude": ["node_modules", "out"]
}
