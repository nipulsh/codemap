{
  "name": "codemap",
  "displayName": "CodeMap",
  "description": "Interactive code architecture visualizer for React, Next.js, and TypeScript",
  "version": "0.1.0",
  "publisher": "nipulsh",
  "repository": {
    "type": "git",
    "url": "https://github.com/nipulsh/codemap.git"
  },
  "homepage": "https://github.com/nipulsh/codemap#readme",
  "bugs": {
    "url": "https://github.com/nipulsh/codemap/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codemap.openArchitecture",
        "title": "CodeMap: Open Architecture"
      },
      {
        "command": "codemap.refreshGraph",
        "title": "CodeMap: Refresh Graph"
      },
      {
        "command": "codemap.generateArchitectureDocument",
        "title": "CodeMap: Generate Architecture Document"
      },
      {
        "command": "codemap.updateArchitectureDocument",
        "title": "CodeMap: Update Architecture Document"
      },
      {
        "command": "codemap.copyAgentContext",
        "title": "CodeMap: Copy Agent Context"
      },
      {
        "command": "codemap.openRouteTrace",
        "title": "CodeMap: Open Route Trace"
      }
    ],
    "configuration": {
      "title": "CodeMap",
      "properties": {
        "codemap.architectureFile": {
          "type": "string",
          "default": "PROJECT_ARCHITECTURE.md",
          "description": "Output filename for generated architecture documentation."
        },
        "codemap.documentation.includeFunctionDetails": {
          "type": "boolean",
          "default": true,
          "description": "Include exported symbol details in architecture documentation."
        },
        "codemap.documentation.includeDependencyGraph": {
          "type": "boolean",
          "default": true,
          "description": "Include dependency overview in architecture documentation."
        },
        "codemap.documentation.agentOptimized": {
          "type": "boolean",
          "default": true,
          "description": "Generate condensed agent-optimized context output."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src shared tests",
    "test": "vscode-test",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "benchmark": "tsx --expose-gc tests/performance/run-all.ts",
    "benchmark:workspace": "tsx --expose-gc tests/performance/run-all.ts workspace-analysis lazy-vs-eager document-size",
    "benchmark:static": "tsx --expose-gc tests/performance/run-all.ts route-analysis call-chain graph-projection",
    "benchmark:runtime": "tsx --expose-gc tests/performance/run-all.ts trace-overlay runtime-collector instrumentation-overhead",
    "benchmark:report": "tsx tests/performance/run-all.ts --report"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@xyflow/react": "^12.6.0",
    "elkjs": "^0.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "express": "^4.22.2",
    "mocha": "^11.1.0",
    "tsx": "^4.19.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
